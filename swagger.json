{
  "openapi": "3.0.0",
  "info": {
    "title": "Portfolio API",
    "description": "API para gerenciamento e avaliação de projetos de portfólio.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/projects": {
      "get": {
        "summary": "Lista os projetos",
        "description": "Retorna os projetos cadastrados, permitindo filtro por tecnologia e paginação.",
        "parameters": [
          {
            "name": "technology",
            "in": "query",
            "description": "Filtra os projetos por tecnologia.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Número da página.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Quantidade de projetos por página.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de projetos retornada com sucesso."
          }
        }
      }
    },

    "/api/projects/{id}/feedbacks": {
      "post": {
        "summary": "Adiciona um feedback ao projeto",
        "description": "Permite registrar a nota e o comentário do professor sobre o projeto.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do projeto.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "rating",
                  "comment"
                ],
                "properties": {
                  "rating": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5,
                    "example": 5
                  },
                  "comment": {
                    "type": "string",
                    "example": "Projeto bem estruturado e organizado."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Feedback registrado com sucesso."
          },
          "400": {
            "description": "Dados inválidos."
          },
          "404": {
            "description": "Projeto não encontrado."
          }
        }
      }
    },

    "/api/projects/{id}/upvote": {
      "put": {
        "summary": "Adiciona um upvote ao projeto",
        "description": "Incrementa a quantidade de curtidas ou estrelas do projeto.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do projeto.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Upvote registrado com sucesso."
          },
          "404": {
            "description": "Projeto não encontrado."
          }
        }
      }
    }
  }
}